#!/usr/bin/env bash
set -euo pipefail

# Keep Omarchy's normal mute toggle and OSD, then mirror that state to the
# laptop's built-in mic so its hardware LED also works with a USB mic selected.
omarchy-audio-input-mute

default_source=$(pactl get-default-source)
if pactl get-source-mute "$default_source" | grep -q 'Mute: yes'; then
  mute_state=1
else
  mute_state=0
fi

internal_mic=$(pactl list short sources | awk -F '\t' '$2 ~ /^alsa_input\.pci-0000_00_1f\.3-platform-skl_hda_dsp_generic\..*__Mic1__source$/ { print $2; exit }')
if [[ -n "$internal_mic" ]]; then
  pactl set-source-mute "$internal_mic" "$mute_state"
fi
