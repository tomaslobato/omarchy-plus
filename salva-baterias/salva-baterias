#!/bin/bash
set -euo pipefail
helper=/usr/local/libexec/salva-baterias-root
[[ -x $helper ]] || { echo 'Falta salva-baterias-root.' >&2; exit 1; }
case "${1:-status}" in
  status|enabled|available|backend)
    exec "$helper" "${1:-status}"
    ;;
  on|off|toggle)
    if [[ $EUID -eq 0 ]]; then
      exec "$helper" "$1"
    elif [[ -t 0 ]]; then
      message=$(sudo "$helper" "$1")
    else
      if ! message=$(pkexec "$helper" "$1" 2>&1); then
        command -v notify-send >/dev/null && notify-send -u critical 'Salva baterías' "No se pudo cambiar el ajuste. $message" || true
        printf '%s\n' "$message" >&2
        exit 1
      fi
    fi
    printf '%s\n' "$message"
    command -v notify-send >/dev/null && notify-send 'Salva baterías' "$message" || true
    ;;
  *)
    echo 'Uso: salva-baterias [status|enabled|available|backend|on|off|toggle]' >&2
    exit 2
    ;;
esac
